# =============================================================================
#  Atlas — env vars for the PROD local stack
#
#  Loaded by packages/api/src/load-env.ts and packages/web/vite.config.ts
#  when ATLAS_ENV=prod is set. `pnpm prod` (root package.json) wraps every
#  prod-side command with `cross-env ATLAS_ENV=prod` so this file is picked
#  up automatically.
#
#  Copy this file to `.env.prod` at the repo root and fill in the blanks
#  (Postgres creds, MCP token). Never commit .env.prod.
#
#  Coexists with the dev and E2E stacks:
#    dev  → web 4000, api 4001, pg :5500/atlas       (.env)
#    prod → web 5000, api 5001, pg :5510/atlas_prod  (this file)
#    e2e  → web 6000, api 6001, pg :5500/atlas_e2e   (e2e/global-setup.ts)
# =============================================================================

# Tells load-env.ts / vite.config.ts to read this file rather than .env.
# This var is also normally set by `cross-env ATLAS_ENV=prod` in the root
# script, but keeping it here lets ad-hoc `pnpm --filter @atlas/api start`
# still pick up prod when the user has ATLAS_ENV exported in their shell.
ATLAS_ENV=prod

# --- Postgres (prod container on host port 5510, db atlas_prod) ---
DATABASE_URL=postgres://localhost:5510/atlas_prod

# docker-compose.yml interpolates these into the postgres-prod service.
POSTGRES_DB_PROD=atlas_prod
POSTGRES_USER_PROD=
POSTGRES_PASSWORD_PROD=

# --- Ports ---
# API_PORT drives Fastify (api defaults to 4001 when unset).
# WEB_PORT drives vite preview / vite dev (defaults to 4000 when unset).
API_PORT=5001
WEB_PORT=5000

# Vite proxies /api requests from the web origin to the API. In prod that
# means localhost:5000 → localhost:5001.
API_PROXY_TARGET=http://127.0.0.1:5001

# --- API runtime (mirror of .env keys; values may differ from dev) ---
ATLAS_LOG_LEVEL=info
ATLAS_REQUEST_LOG=false
ATLAS_LOG_FILE=
ATLAS_FEEDBACK_URL=https://github.com/sspartorg/atlas/issues

# Set to `true` to spawn the real Claude / Copilot / Ollama CLI on agent runs.
ATLAS_AI_ENABLED=false

# Ollama's Anthropic-compatible endpoint, used by agents/terminals with
# `cli = ollama`. See .env.example for the full note.
ATLAS_OLLAMA_BASE_URL=http://localhost:11434

# Shared secret for MCP write calls. Recommend a separate token from dev so
# a leaked dev token can't write to prod.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ATLAS_MCP_TOKEN=

# Opt-in: trust the host machine's LAN IPs as browser origins. The boot log
# prints which IPs got added; LAN entries here will use WEB_PORT (5000).
ATLAS_LAN_ACCESS=false
