# =============================================================================
#  Atlas — env vars for the DEV local stack
#
#  Three parallel stacks live in this repo, each on dedicated host ports
#  so they coexist without colliding with each other or with other apps
#  using framework defaults:
#    dev  (this file, .env)       → web 4000, api 4001, pg :5500/atlas
#    prod (.env.prod / .example)  → web 5000, api 5001, pg :5510/atlas_prod
#    e2e  (e2e/global-setup.ts)   → web 6000, api 6001, pg :5500/atlas_e2e
#
#  MCP runs on a single fixed port 4500 (first-boot-wins between dev/prod).
#
#  The API loads dev or prod via packages/api/src/load-env.ts, gated
#  by the ATLAS_ENV env var: `ATLAS_ENV=prod` → .env.prod, otherwise .env.
#  Vite (packages/web/vite.config.ts) follows the same rule. Every entry
#  point — `pnpm dev`, `pnpm start`, `pnpm prod`, `pnpm db:migrate`,
#  `pnpm --filter @atlas/api dev` — hits the right set.
#
#  Copy this file to `.env` at the repo root and fill in the blanks.
#  See `.env.prod.example` for the prod-side template.
#  Never commit `.env` or `.env.prod` themselves.
# =============================================================================

# --- Postgres ---
# Connection string used by @atlas/api at runtime AND by Knex migrations.
# When running via docker-compose, host = localhost from the API process
# on the host (port mapped 5500:5432 — host port 5500, container port 5432).
DATABASE_URL=postgres://localhost:5500/atlas

# --- Dev stack ports ---
# Set explicitly so dev never collides with prod (5000/5001), E2E (6000/6001),
# or another app on the machine using framework defaults (5173 / 3001).
WEB_PORT=4000
API_PORT=4001
API_PROXY_TARGET=http://127.0.0.1:4001

# Docker compose interpolates these into the postgres service definition.
POSTGRES_DB=atlas
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- API runtime ---
# Logging verbosity for the Fastify logger. fatal | error | warn | info | debug | trace
ATLAS_LOG_LEVEL=info

# Fastify per-request lifecycle logs ("incoming request" / "request completed",
# one pair per HTTP call at info level) are silenced by default — even at
# ATLAS_LOG_LEVEL=info or debug. Flip to `true` to bring them back when
# you're chasing a specific request path.
ATLAS_REQUEST_LOG=false

# Persistent API log file. Defaults to ./logs/atlas-api.log (relative to repo).
# Set to `off` to disable file logging. The directory is created on demand.
ATLAS_LOG_FILE=

# Where the in-app "Report a bug" link (sidenav footer + Settings → Help & About)
# points. Defaults to the upstream GitHub Issues tracker; set to a mailto: URL if
# you'd rather collect bug reports by email, or leave blank to hide the link.
# For mailto: targets, the link prefills subject + body with the current page
# path and a pointer to ./logs/atlas-api.log.
ATLAS_FEEDBACK_URL=https://github.com/sspartorg/atlas/issues

# Set to `true` to spawn the real Claude / Copilot / Ollama CLI on agent runs.
# Default (unset or anything else) puts agent-runner.ts into simulated
# mode that emits canned output — useful for development without burning
# CLI credits.
ATLAS_AI_ENABLED=false

# Where the `ollama` CLI option points. Ollama serves an Anthropic-compatible
# API, so agents and terminals with `cli = ollama` run the SAME `claude` binary
# with ANTHROPIC_BASE_URL pointed here (see services/ollama-env.ts). Change it
# to reach an Ollama box elsewhere on your LAN, or a non-default port. Leave
# blank to use the default below.
#   Requires: Ollama installed and `ollama pull <model>` for each model you
#   register under Settings -> Model Registry -> Ollama.
ATLAS_OLLAMA_BASE_URL=http://localhost:11434

# Shared secret the API requires on every write-side MCP call. The global
# onRequest hook in server.ts gates POST/PUT/PATCH/DELETE behind this token
# for external MCP clients (the local browser is allowed through unchanged).
#
# Leave blank to disable (only safe in single-user local dev).
# Production: set to a 64-char random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ATLAS_MCP_TOKEN=

# Opt-in: trust the host machine's LAN IPs as browser origins. When set to
# `true` (or `1`), API boot scans `os.networkInterfaces()` for non-loopback
# IPv4 addresses and adds `http://<ip>:4000` to both the CORS allowlist and
# the MCP-token gate's trusted-browser-origin set. This is the switch that
# lets you open the UI from a second device on the same Wi-Fi and actually
# post comments / edit items (writes; reads worked already).
#
# Default (unset) keeps Atlas locked to localhost — safer when you don't
# want the API reachable from any other device on your network.
ATLAS_LAN_ACCESS=false

# --- API keys & per-tool credentials (Jira, OpenAI, Anthropic, etc.) ---
# These are NOT set here. Atlas stores them encrypted in its database and
# you enter them through the app at Settings → Credentials after first run.
# Only the variables above (Postgres, MCP token, Telegram bot, log level,
# LAN access) belong in this file.
