# Mirror of .gitignore for files that legitimately hold secrets at runtime
# but are never staged for commit. The pre-commit hook only sees staged files
# (via lint-staged), so these patterns just keep the full-tree manual scan
# (`pnpm exec secretlint "**/*"`) honest.
.env
.env.local
.env.backup
.env.bak

# Dependency trees + build output — large, slow, and not eligible for commit.
node_modules/
dist/
coverage/
.vite/

# Atlas-specific generated/transient
packages/api/mcp-config.generated.json
.husky/_/
