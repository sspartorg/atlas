{
    "id": "delivery",
    "name": "Delivery",
    "description": "PO Writer splits a Task into sub-tasks and the Architect specs them. Every dev sub-task is built, every [QA] sub-task tested and every [DOC] sub-task documented, one at a time on the Task's branch. Four deterministic gates then check hygiene, coverage, performance and visuals - each costs nothing when green, and when one goes red a specialist fixes it and a reviewer checks the fix was made at the cause rather than by defeating the check. A release reviewer reads the whole change before it becomes one pull request. Unclear Tasks come back to you.",
    "version": 3,
    "input_kind": "item",
    "trigger": "item_ready",
    "use_worktree": true,
    "push_code": true,
    "raises_pr": true,
    "max_loops": 12,
