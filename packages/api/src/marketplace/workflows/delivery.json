{
  "id": "delivery",
  "name": "Delivery",
  "description": "PO Writer splits a Task into sub-tasks and the Architect specs them. Every dev sub-task is built, every [QA] sub-task tested and every [DOC] sub-task documented, one at a time on the Task's branch. Then three Script steps run the commands you typed on them, in order: Lint, Build and Tests. Atlas runs each command itself, with no AI in the loop, and saves its full output under .atlas/checks/. When one goes red, a fixer reads that log, and a reviewer checks the fix was made at the cause rather than by defeating the check. The Script steps ship empty: type each project's own command into the step in the workflow builder before a run, or the run parks. A release reviewer reads the whole change before it becomes one pull request; a gap it finds becomes a fix sub-task that is built and re-verified without waking you. Unclear Tasks come back to you.",
  "version": 3,
  "input_kind": "item",
  "trigger": "item_ready",
  "use_worktree": true,
  "push_code": true,
  "raises_pr": true,
  "max_loops": 12,
