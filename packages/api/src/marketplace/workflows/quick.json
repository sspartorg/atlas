{
  "id": "quick",
  "name": "Quick change",
  "description": "For small changes that need no breakdown: the Coder implements the Task itself on its branch, the Code Reviewer approves it, then a Tests Script step runs the command typed on it. Atlas runs it with no AI and saves the output under .atlas/checks/; a red suite goes to a coverage fixer and a reviewer who checks the fix was made at the cause. Then one pull request.",
  "version": 3,
  "input_kind": "item",
  "trigger": "item_ready",
  "use_worktree": true,
  "push_code": true,
  "raises_pr": true,
  "max_loops": 8,
