            { "id": "qa-writer", "type": "agent", "agent_id": "agent-qa-writer", "position": { "x": 220, "y": 120 } },
            { "id": "qa-review", "type": "agent", "agent_id": "agent-qa-reviewer", "position": { "x": 480, "y": 120 } },
            { "id": "automation", "type": "agent", "agent_id": "agent-automation", "position": { "x": 740, "y": 120 } },
